.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: #f7f6f3;
}

/* 半屏：抖音在上面放视频，这块只剩一半高度。收紧一切，保证按钮不被挤出屏幕。 */
.page.compact .panel {
  padding-top: 10rpx;
}
.page.compact .grabber {
  margin-bottom: 12rpx;
}
.page.compact .head {
  margin-bottom: 10rpx;
}
.page.compact .name {
  font-size: 34rpx;
}
.page.compact .left {
  font-size: 84rpx;
}
.page.compact .rest {
  padding: 4rpx 0 12rpx;
}
.page.compact .btn {
  height: 92rpx;
  line-height: 92rpx;
}
.page.compact .actions {
  margin-bottom: 8rpx;
}

/* 全屏打开时这里是今天的信息和教练口令；从视频挂载进来是半屏，这一块基本看不到 */
.top {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 24rpx 48rpx 40rpx;
}
.daywrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.day {
  font-size: 28rpx;
  letter-spacing: .3em;
  color: #a8a294;
}
.day-sub {
  font-size: 24rpx;
  color: #8a8577;
  font-variant-numeric: tabular-nums;
}
.cue {
  font-size: 28rpx;
  line-height: 1.7;
  color: #6f6a5f;
  text-align: center;
  margin-top: 10rpx;
}
.next-ex {
  font-size: 24rpx;
  color: #a8a294;
}
.who {
  font-size: 22rpx;
  color: #0e0e0e;
  opacity: .8;
}

.panel {
  background: #fffefc;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 8rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 26rpx rgba(0, 0, 0, .12);
}

.grabber {
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #d8d3c6;
  margin: 0 auto 10rpx;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -.02em;
}
.sets {
  font-size: 23rpx;
  color: #6f6a5f;
}

.main {
  display: flex;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

/* 待完成时的一行：两个步进器 + 完成按钮，面板只占底部一条 */
.row1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.row1 .mini {
  flex: 1;
  justify-content: space-between;
}
.row1 .go {
  flex: 0 0 auto;
  padding: 0 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}
.clock {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -.04em;
  font-variant-numeric: tabular-nums;
  min-width: 150rpx;
}
.chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  background: #ecebe7;
  color: #3d3b35;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}
.restmini {
  display: flex;
  justify-content: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
  padding-left: 2rpx;
}
/* 休息时这四个动作做成小胶囊，靠左排：手指按上去会挡住，纯文字链接看不出点没点中 */
.act {
  flex: 0 0 auto;
  padding: 0 20rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 24rpx;
  background: #ecebe7;
  color: #3d3b35;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

/* 收起态：一条窄栏，只留倒计时/下一组，点一下展开 */
.panel.mini {
  padding-top: 6rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.panel.mini .grabber {
  margin-bottom: 6rpx;
}
.minibar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 6rpx 0 6rpx;
}
.mclock {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -.03em;
  font-variant-numeric: tabular-nums;
}
.mnext {
  flex: 1;
  font-size: 24rpx;
  color: #6f6a5f;
  font-variant-numeric: tabular-nums;
}
.mexp {
  font-size: 22rpx;
  color: #8a8577;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.fold {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #8a8577;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.tlink {
  font-size: 22rpx;
  color: #6f6a5f;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.stepper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ecebe7;
  border-radius: 20rpx;
  padding: 10rpx 14rpx;
}
.stepbtn {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #e4e3df;
  color: #2a2823;
  font-size: 34rpx;
  font-weight: 600;
}
.numwrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.num {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -.03em;
}
.unit {
  font-size: 20rpx;
  color: #6f6a5f;
}

.rest {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 10rpx;
}
.left {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -.04em;
  font-variant-numeric: tabular-nums;
}
.left.mid {
  font-size: 56rpx;
  letter-spacing: 0;
}
.next {
  font-size: 28rpx;
  color: #6f6a5f;
  margin-top: 6rpx;
}

/* 下一组的重量 / 次数：休息时最常改的两个数 */
.nextwrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  margin-top: 6rpx;
}
.nextlabel {
  font-size: 20rpx;
  letter-spacing: .2em;
  color: #8a8577;
}
.nextrow {
  display: flex;
  gap: 12rpx;
}
.mini {
  display: flex;
  align-items: center;
  gap: 2rpx;
  background: #ecebe7;
  border-radius: 16rpx;
  padding: 4rpx 8rpx;
}
.mbtn {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #e4e3df;
  color: #2a2823;
  font-size: 30rpx;
  font-weight: 600;
}
.mval {
  min-width: 86rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.munit {
  font-size: 18rpx;
  font-weight: 400;
  color: #6f6a5f;
  margin-left: 3rpx;
}
.restadj {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
}
.adj {
  /* 健身房里手上有汗、可能戴手套：这两个按钮不能只有字那么高 */
  min-width: 120rpx;
  padding: 12rpx 26rpx;
  border-radius: 16rpx;
  background: #ecebe7;
  color: #3d3b35;
  font-size: 24rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-bottom: 10rpx;
}
.actions.sub {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}
.actions.sub .btn {
  flex: 1;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  font-size: 20rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.primary {
  background: #0e0e0e;
  color: #f7f6f3;
}
.ghost {
  background: #ecebe7;
  color: #0e0e0e;
}
.pressed {
  opacity: .72;
}

.foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  font-size: 21rpx;
  color: #8a8577;
  padding-top: 2rpx;
}
.footl {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.footl.link {
  color: #0e0e0e;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}
.footl.warn {
  color: #b0231b;
}
.pct {
  font-variant-numeric: tabular-nums;
}
.hlink {
  font-size: 21rpx;
  color: #8a8577;
  text-decoration: underline;
  text-underline-offset: 4rpx;
  margin-right: 14rpx;
}

/* 换动作弹层：白纸贴在面板上，和主面板同一套纸墨 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 10, 8, .38);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 20;
}
.sheet {
  background: #fffefc;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0e0e0e;
}
.sheet-x {
  font-size: 40rpx;
  color: #8a8577;
  padding: 0 8rpx;
}
.sheet-hint {
  font-size: 22rpx;
  color: #8a8577;
  margin-top: 8rpx;
}
.picklist {
  margin-top: 18rpx;
  max-height: 52vh;
}
.pick {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #e4e3df;
}
.pickname {
  font-size: 30rpx;
  color: #0e0e0e;
}
.pickeq {
  font-size: 22rpx;
  color: #8a8577;
}
.sheet-state {
  font-size: 24rpx;
  color: #8a8577;
  padding: 24rpx 0 8rpx;
}

.exinput {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e4e3df;
  background: #faf9f5;
  font-size: 28rpx;
  color: #0e0e0e;
}
.infoimg {
  width: 100%;
  height: 420rpx;
  background: #f2f0ea;
  margin-top: 16rpx;
}
.inforow {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid #e4e3df;
  font-size: 24rpx;
  color: #4b463c;
}
.infokey {
  color: #8a8577;
}

.infofallback {
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  background: #f2f0ea;
  border: 1rpx solid #e4e3df;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.ifb-name {
  font-size: 40rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-weight: 700;
  color: #0e0e0e;
}
.ifb-sub {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #8a8577;
}

.vplayhint {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #8a8577;
}

.steps {
  margin-top: 22rpx;
  border-top: 1rpx solid #e4e3df;
  padding-top: 18rpx;
}
.stepsk {
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #8a8577;
}
.step {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.stepn {
  font-size: 20rpx;
  color: #8a8577;
  width: 30rpx;
  text-align: right;
  flex: none;
}
.stept {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #2a2823;
}

.rirrow { display: flex; align-items: center; gap: 12rpx; margin: 10rpx 0 4rpx; }
.rirlabel { font-size: 20rpx; color: #8a8577; letter-spacing: 4rpx; }
.rirchip {
  padding: 8rpx 18rpx;
  border: 1rpx solid #e4e3df;
  border-radius: 999rpx;
  background: #fffefc;
  font-size: 20rpx;
}
.rirchip.on { background: #0e0e0e; border-color: #0e0e0e; color: #f7f6f3; }

.ssbadge {
  font-size: 18rpx;
  color: #b0231b;
  border: 1rpx solid #b0231b;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-left: 10rpx;
}

.prow { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; }
.plab { width: 80rpx; font-size: 22rpx; color: #8a8577; }
.pinput {
  flex: 1;
  padding: 16rpx 18rpx;
  border: 1rpx solid #e4e3df;
  background: #fffefc;
  font-size: 26rpx;
}
.punit { font-size: 20rpx; color: #8a8577; }
.pval { font-size: 30rpx; font-family: "Songti SC", serif; font-weight: 700; }
.plates { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.plate {
  min-width: 76rpx;
  text-align: center;
  padding: 14rpx 0;
  background: #0e0e0e;
  color: #f7f6f3;
  font-size: 24rpx;
}
.pempty { font-size: 22rpx; color: #8a8577; }
.phint { display: block; margin-top: 14rpx; font-size: 20rpx; color: #b0231b; }

.rpe { font-size: 18rpx; color: #8a8577; margin-left: auto; }

.menurow {
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid #e4e3df;
  font-size: 26rpx;
}
.menurow.danger { color: #b0231b; border-bottom: none; }
.lastline { font-size: 18rpx; color: #8a8577; margin-left: 10rpx; }

.focus {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 900;
  background: #f7f6f3;
  padding: 60rpx 48rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.ftop { display: flex; justify-content: space-between; align-items: baseline; }
.fnext { font-size: 20rpx; color: #8a8577; }
.fexit { font-size: 22rpx; color: #6f6a5f; text-decoration: underline; }
.fname {
  margin-top: 60rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
}
.fset { margin-top: 12rpx; font-size: 24rpx; color: #8a8577; letter-spacing: 4rpx; }
.fnum {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}
.fv { font-size: 132rpx; font-weight: 700; font-family: "Songti SC", serif; line-height: 1; }
.fu { font-size: 34rpx; margin-left: 8rpx; color: #6f6a5f; }
.fx { font-size: 52rpx; color: #b0231b; }
.fside { margin-top: 10rpx; font-size: 22rpx; color: #b0231b; }
.factions { margin-top: auto; }
.fbig {
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  padding: 42rpx 0;
}
.fbig.primary { background: #0e0e0e; color: #f7f6f3; }
.frow2 { display: flex; gap: 16rpx; margin-top: 16rpx; }
.fbtn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  border: 1rpx solid #d8d3c6;
  font-size: 24rpx;
}

/* 重建模板时补齐的类 */
.mchev { font-size: 22rpx; color: #8a8577; margin-left: 12rpx; }
.exhead { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.setrow { display: flex; align-items: baseline; justify-content: space-between; margin-top: 6rpx; }
.setline { font-size: 22rpx; color: #6f6a5f; }
.clock.dim { opacity: .4; }
.nameinput {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e4e3df;
  background: #fffefc;
  font-size: 26rpx;
}
.savebtn {
  margin-top: 22rpx;
  text-align: center;
  background: #0e0e0e;
  color: #f7f6f3;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  padding: 24rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e4e3df;
}
.rl { display: flex; flex-direction: column; gap: 6rpx; }
.rn { font-size: 26rpx; }
.rs { font-size: 20rpx; color: #8a8577; }
.infovideo {
  width: 100%;
  height: 380rpx;
  margin-top: 16rpx;
  background: #0e0e0e;
}

.footrow { display: flex; gap: 30rpx; margin-top: 6rpx; }

/* 顶部信息：竖排，别和已登录/下一个挤一行 */
.head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 0 8rpx 12rpx;
}
.head .daywrap { display: flex; flex-direction: column; gap: 4rpx; }
.head .day { font-size: 28rpx; font-weight: 600; letter-spacing: 4rpx; }
.head .day-sub { font-size: 20rpx; color: #8a8577; }
.head .cue { font-size: 20rpx; color: #6f6a5f; }
.head .who { font-size: 18rpx; color: #8a8577; }
.head .next-ex { font-size: 18rpx; color: #8a8577; }

.photohint { display: block; margin-top: 14rpx; font-size: 18rpx; color: #8a8577; text-align: center; }

.sheet-acts { display: flex; align-items: center; gap: 24rpx; }
.sheet-ok {
  font-size: 26rpx;
  color: #0e0e0e;
  border-bottom: 2rpx solid #0e0e0e;
  padding-bottom: 2rpx;
}
.sheet { padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }

.sheet-primary {
  margin-top: 18rpx;
  text-align: center;
  background: #0e0e0e;
  color: #f7f6f3;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  padding: 28rpx 0;
}

.foot { padding: 6rpx 0 0; gap: 6rpx; }
.foot .footl { font-size: 20rpx; line-height: 1.4; }
.footrow { margin-top: 2rpx; }
.hlink { font-size: 18rpx; }
