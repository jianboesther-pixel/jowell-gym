<view class="page">
  <view class="head">
    <text class="title">绑定已有账号</text>
    <text class="sub">一次就好。绑定后，抖音里看到的计划就是你平时练的那份。</text>
  </view>

  <view class="form">
    <input class="field" placeholder="账号名（你现在登录用的名字）" placeholder-class="ph" value="{{name}}" bindinput="onName" />
    <input class="field" password placeholder="密码" placeholder-class="ph" value="{{password}}" bindinput="onPassword" />
    <text class="err" tt:if="{{err}}">{{err}}</text>
    <view class="btn {{busy ? 'busy' : ''}}" hover-class="pressed" bindtap="onSubmit">{{busy ? '绑定中…' : '绑定'}}</view>
  </view>

  <text class="foot">还没有账号？不用绑——你现在这个就是新账号，直接练就行。</text>
</view>
