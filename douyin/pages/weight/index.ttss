page {
  background: #f7f6f3;
  color: #0e0e0e;
}
.wrap {
  min-height: 100vh;
  padding: 48rpx 44rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.word {
  font-size: 22rpx;
  letter-spacing: 10rpx;
  color: #8a8577;
}
.inputrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 40rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid #0e0e0e;
  border-bottom: 1rpx solid #e4e3df;
}
.input {
  flex: 1;
  font-size: 56rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-weight: 700;
}
.unit {
  font-size: 24rpx;
  color: #6f6a5f;
}
.save {
  background: #0e0e0e;
  color: #f7f6f3;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  padding: 20rpx 34rpx;
  border-radius: 2rpx;
}
.msg {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #2f6b4f;
}
.err {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b0231b;
}
.rows {
  margin-top: 32rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #e4e3df;
}
.d {
  font-size: 22rpx;
  color: #6f6a5f;
  letter-spacing: 2rpx;
}
.v {
  font-size: 30rpx;
  font-family: "Songti SC", "Noto Serif SC", serif;
  font-weight: 700;
}
.empty {
  display: block;
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #8a8577;
}

.ov { display: flex; gap: 18rpx; margin-top: 28rpx; }
.ocell { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.onum { font-size: 40rpx; font-family: "Songti SC", serif; font-weight: 700; }
.onum.up { color: #b0231b; }
.onum.down { color: #2f6b3a; }
.olab { font-size: 18rpx; color: #8a8577; }
.chart { display: flex; align-items: flex-end; gap: 8rpx; height: 180rpx; margin-top: 30rpx; }
.cbar { flex: 1; background: #0e0e0e; min-height: 8rpx; }
.range { display: block; margin-top: 10rpx; font-size: 18rpx; color: #8a8577; }
.del { font-size: 20rpx; color: #b0231b; padding-left: 20rpx; }

.goalrow { display: flex; align-items: center; gap: 12rpx; margin-top: 26rpx; }
.glab { font-size: 20rpx; letter-spacing: 4rpx; color: #8a8577; }
.ginput {
  flex: 1;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e4e3df;
  background: #fffefc;
  font-size: 24rpx;
}
.gunit { font-size: 20rpx; color: #8a8577; }
.gsave {
  font-size: 22rpx;
  border: 1rpx solid #0e0e0e;
  padding: 12rpx 22rpx;
}
.gdiff { display: block; margin-top: 12rpx; font-size: 20rpx; color: #6f6a5f; }

.otherlink { margin-top: 30rpx; text-align: center; font-size: 22rpx; color: #6f6a5f; text-decoration: underline; }
