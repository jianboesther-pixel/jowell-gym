page {
  background: #f7f6f3;
  color: #0e0e0e;
}
.wrap {
  min-height: 100vh;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.word { font-size: 22rpx; letter-spacing: 10rpx; color: #8a8577; }
.err { display: block; margin-top: 16rpx; font-size: 22rpx; color: #b0231b; }

.addrow {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
  align-items: center;
}
.noteinput {
  flex: 1;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e4e3df;
  background: #fffefc;
  font-size: 22rpx;
}
.addbtn {
  flex: none;
  padding: 18rpx 24rpx;
  background: #0e0e0e;
  color: #f7f6f3;
  font-size: 22rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 26rpx;
}
.cell {
  width: 47%;
  position: relative;
}
.thumb {
  width: 100%;
  height: 320rpx;
  background: #eceae3;
}
.cd { display: block; margin-top: 8rpx; font-size: 20rpx; color: #6f6a5f; }
.cn { display: block; font-size: 18rpx; color: #8a8577; }
.cdel {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 6rpx 14rpx;
  background: rgba(14, 14, 14, .72);
  color: #f7f6f3;
  font-size: 18rpx;
}
.empty { display: block; margin-top: 30rpx; font-size: 22rpx; color: #8a8577; line-height: 1.7; }
